# Variáveis de ambiente da API. Em dev (perfil padrão) todas têm valor padrão;
# em produção (SPRING_PROFILES_ACTIVE=prod) as marcadas como obrigatórias precisam ser definidas.
# Nunca coloque valores reais neste arquivo.

SPRING_PROFILES_ACTIVE=dev

# Banco (obrigatórias em prod)
DB_URL=jdbc:postgresql://localhost:5432/gymwork
DB_USERNAME=gymwork
DB_PASSWORD=gymwork

# JWT (obrigatória em prod; mínimo 32 caracteres aleatórios)
JWT_SECRET=
JWT_EXPIRATION=PT15M
REFRESH_TOKEN_TTL=P30D
AUTH_COOKIE_SECURE=false

# Frontend (obrigatórias em prod)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# E-mail (MAIL_HOST obrigatória em prod)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Gym Work <no-reply@gymwork.local>

# Fotos de evolução (obrigatórias em prod): pasta privada e segredo das URLs assinadas (mín. 32 caracteres)
STORAGE_DIR=./data/uploads
STORAGE_URL_SECRET=

SERVER_PORT=8080
